{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finncalc.com/_build/schemas/comparison.schema.json",
  "title": "Comparison",
  "type": "object",
  "required": [
    "slug",
    "title",
    "description",
    "h1",
    "subtitle",
    "embedsCalcSlug",
    "embedMode",
    "status",
    "publishedDate",
    "updatedDate",
    "lastReviewed",
    "wordCount",
    "faq",
    "relatedComparisonSlugs"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 10, "maxLength": 120 },
    "description": { "type": "string", "minLength": 50, "maxLength": 200 },
    "h1": { "type": "string", "minLength": 5, "maxLength": 120 },
    "subtitle": { "type": "string" },
    "embedsCalcSlug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "embedMode": { "enum": ["iframe", "link"] },
    "status": { "enum": ["published", "draft"] },
    "publishedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updatedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "wordCount": { "type": "integer", "minimum": 0 },
    "faq": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["q", "a"],
        "additionalProperties": false,
        "properties": {
          "q": { "type": "string", "minLength": 5 },
          "a": { "type": "string", "minLength": 10 }
        }
      }
    },
    "relatedComparisonSlugs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    }
  }
}
